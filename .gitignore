# This is the KIT's own ignore file.
# Not to be confused with .gitignore.template, which is copied into generated
# site repos (and deliberately ignores *.md). Here the .md docs are the product.

node_modules/

# Secrets / local env
.env
.env.*
!.env.example

# A real site config must never land in the kit — only the example is tracked
site.config.yaml

# Script + tool output
report.json
.wrangler/

# Editor / agent / OS
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
